# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token

# Публичный адрес webapp (ngrok или домен), он же в настройках Mini App у BotFather
WEBAPP_URL=https://your-domain.ngrok-free.dev

# Ключ шифрования сессий (32 байта в base64). Сгенерировать:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
SESSION_KEYS=base64_encoded_32_bytes

# Прокси для pulse.mirea.ru (опционально). Из дата-центров Пульс часто недоступен —
# тогда укажите российский socks5/http прокси. Пусто = без прокси.
MIREA_PROXY=

# Лимит друзей на пользователя
FRIEND_LIMIT=30

# Путь к базе SQLite
DATABASE_PATH=./data/insync.db

# Отладочные дампы страниц входа в data/ (1 = включить). В проде оставить пустым.
PULSE_DEBUG=
