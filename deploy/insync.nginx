# nginx-сайт для InSync. Копировать в /etc/nginx/sites-available/insync,
# заменить server_name на свой домен, затем включить и выпустить сертификат.
server {
    listen 80;
    server_name ВАШ_ДОМЕН;

    # собранный webapp (npm run build -> webapp/dist)
    root /opt/insync/webapp/dist;
    index index.html;

    # API и бот — на backend (uvicorn слушает только localhost)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: любые пути отдаём index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
